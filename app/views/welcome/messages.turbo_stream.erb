<%= turbo_stream.append "messages" do %>
  <li class="flex items-center gap-2 rounded-lg bg-white border border-gray-100 px-3 py-2 shadow-sm">
    <span class="text-[#1B6E78]">●</span>
    <span class="flex-1 break-all"><%= @message %></span>
    <span class="text-gray-400 text-xs"><%= Time.current.strftime("%H:%M:%S") %></span>
  </li>
<% end %>

<%# Turbo 不会自动清空表单（源码无 reset 逻辑），用 replace 把表单换成全新空表单来清空输入框 %>
<%= turbo_stream.replace "message-form" do %>
  <%= render "message_form" %>
<% end %>
