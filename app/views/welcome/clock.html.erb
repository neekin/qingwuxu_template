<%= turbo_frame_tag "clock" do %>
  <div class="flex items-center gap-3 text-sm">
    <span class="font-mono text-[#1B6E78]"><%= @time.strftime("%Y-%m-%d %H:%M:%S") %></span>
    <%= link_to "刷新", clock_path, data: { turbo_frame: "clock" },
          class: "text-[#BF8430] hover:underline" %>
  </div>
<% end %>
